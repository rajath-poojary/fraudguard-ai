# Application
APP_NAME=FraudGuard
APP_ENV=development
LOG_LEVEL=info

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraudguard
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth (replace in every environment)
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Simulator / ingest (server-side only)
INGEST_API_KEY=change_me_ingest_key
