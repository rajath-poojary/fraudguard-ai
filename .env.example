# ============================================================================
# FraudGuard Environment Configuration
# ============================================================================
# Copy this file to .env and replace all placeholder values with actual
# secrets. Never commit .env to version control.
# ============================================================================

# Application Environment
APP_NAME=FraudGuard
APP_ENV=development
LOG_LEVEL=info

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraudguard
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=change_me

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (SECURITY: Replace with strong random values in production)
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# API Key for Transaction Ingestion (SECURITY: Replace with strong random value)
# Generate INGEST_API_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=change_me_ingest_key

# Database Migrations
ALEMBIC_SQLALCHEMY_URL=postgresql+psycopg2://fraudguard:change_me@postgres:5432/fraudguard

# Optional: Development/Testing
DEBUG=false
TESTING=false

